# ===== 培英 AI 行政平台 - 环境变量配置 =====
# 复制此文件为 .env 并填入真实值

# 项目信息
PROJECT_NAME=培英 AI 行政平台
VERSION=0.1.0

# JWT 认证 - 生产环境请更换为随机字符串
SECRET_KEY=change-this-secret-key-in-production

# 数据库 - 开发模式使用 SQLite，生产环境切换为 PostgreSQL
# DATABASE_URL=sqlite+aiosqlite:///./school_ai_dev.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/school_ai

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=52428800

# ===== OCR 配置 =====
# 可选: mock | xfyun
OCR_BACKEND=xfyun

# 讯飞 OCR 密钥
XFYUN_APPID=your_xfyun_appid
XFYUN_API_SECRET=your_xfyun_api_secret
XFYUN_API_KEY=your_xfyun_api_key
XFYUN_OCR_URL=https://cbm01.cn-huabei-1.xf-yun.com/v1/private/se75ocrbm

# ===== AI / LLM 配置 =====
# 可选: mock | openai
LLM_BACKEND=openai

# LLM API 地址（支持 OpenAI / DeepSeek / 其他兼容 API）
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini

# 文档分类策略: keyword | llm | api
CLASSIFICATION_BACKEND=llm

# ===== 邮件配置 (SMTP) =====
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@py.edu.hk
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@py.edu.hk
SMTP_USE_TLS=true

# ===== 日志 =====
LOG_LEVEL=INFO
